<UserControl x:Class="EncodeNavi.View.GoalSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:recommendation="clr-namespace:EncodeNavi.Recommendation">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Click="DetailsButton_Click" Padding="4,2" Margin="0,2" VerticalAlignment="Center"
                    ToolTip="推奨値の理由やEncodeNaviの設定を詳細ウィンドウで表示します">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
            </Button>
            <Label Content="EncodeNavi" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Label Content="目的" ToolTip="EncodeNavi が推奨値を決めるときの目的です。YMM4の出力設定は変わりません"/>
            <ctrl:EnumComboBox Grid.Column="1" EnumType="{x:Type recommendation:EncodeGoal}" Value="{Binding Goal}"/>
        </Grid>
        <Grid Visibility="{Binding IsPlatformSelectable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Label Content="投稿先"/>
            <ctrl:EnumComboBox Grid.Column="1" EnumType="{x:Type recommendation:TargetPlatform}" Value="{Binding Platform}"/>
        </Grid>
        <Separator/>
    </StackPanel>
</UserControl>
